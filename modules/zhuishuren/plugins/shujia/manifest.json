  "api_version": 1,
  "version": "0.1.0",
  "hooks": [
    "clue",
    "command",
    "answer"
  ],
  "capabilities": [
    "panel",
    "prompt",
    "show",
    "note",
    "attitude",
    "hint"
  ],
  "actions": [],
  "commands": [
    {
      "name": "理书架",
      "description": "在书房把剩下的书按道格拉斯的老规矩排回去"
    }
  ],
  "flags": {},
  "initial": {},
