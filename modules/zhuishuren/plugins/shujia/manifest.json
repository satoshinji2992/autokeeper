        {
          "key": "shelf",
          "title": "旧书架",
          "rows": [
            {
              "kind": "art",
              "art": "+---------------------------+\n|[    ] [    ] [    ] [    ]|\n+---------------------------+"
            },
            {
              "kind": "text",
              "text": "架上空着好几格，像缺了牙。"
            },
            {
              "kind": "bar",
              "text": "理书",
              "value": 0,
              "max": 4,
              "color": "accent"
            },
            {
              "kind": "text",
              "text": "在书房输入 /理书架，把剩下的书排回去。",
              "color": "dim"
            }
          ]
        }
      ]
    },
    {
