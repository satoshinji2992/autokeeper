        "gate_fails": 0,
        "ready": false,
        "transforming": true
      },
      "context": {
        "investigators": [
          {
            "id": "lin_xiaozhou"
          }
        ]
      },
      "dice": [],
      "checks": [
        false
      ],
      "expected_state": {
        "levels": {
          "lin_xiaozhou": 3
        }
      },
      "expected_effects": [
        {
          "kind": "condition",
          "who": "lin_xiaozhou",
          "key": "听见大海的呼唤",
          "amount": 1
        },
        {
          "kind": "hint",
          "text": "这名调查员开始隐约听见大海的呼唤。"
        }
      ],
      "expected_panels": null
    },
    {
      "name": "闸门第三次失败遇巡逻",
      "event": {
        "hook": "action",
        "action": "gate_fail",
        "arguments": {
          "patrol": true
        }
      },
      "state": {
        "seen": [],
        "levels": {},
        "gate_fails": 2,
        "ready": false,
        "transforming": false
      },
      "context": {},
      "dice": [
        1
      ],
      "checks": [],
      "expected_state": {
        "gate_fails": 3
      },
      "expected_effects": [
        {
          "kind": "hint",
          "text": "这次封堵没有成功，又额外耗去了一小时。"
        },
        {
          "kind": "hint",
          "text": "通道深处，一只巡逻的深潜者朝闸门口过来了。"
        }
      ],
      "expected_panels": null
    },
    {
      "name": "闸门失败不启用巡逻",
      "event": {
        "hook": "action",
        "action": "gate_fail",
        "arguments": {}
      },
      "state": {
        "seen": [],
        "levels": {},
        "gate_fails": 2,
        "ready": false,
        "transforming": false
      },
      "context": {},
      "dice": [],
      "checks": [],
      "expected_state": {
        "gate_fails": 3
      },
      "expected_effects": [
        {
          "kind": "hint",
          "text": "这次封堵没有成功，又额外耗去了一小时。"
        }
      ],
      "expected_panels": null
    }
  ]
}