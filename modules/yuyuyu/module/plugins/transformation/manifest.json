        true
      ],
      "expected_state": {
        "levels": {}
      },
      "expected_effects": [],
      "expected_panels": null
    },
    {
      "name": "接触水源失败开始转变",
      "event": {
        "hook": "action",
        "action": "contact_water",
        "arguments": {
          "who": "lin_xiaozhou"
        }
      },
      "state": {
        "seen": [],
        "levels": {},
        "gate_fails": 0,
        "ready": false,
        "transforming": false
      },
      "context": {
        "investigators": [
          {
            "id": "lin_xiaozhou"
          }
        ]
      },
      "dice": [],
      "checks": [
        false
      ],
      "expected_state": {
        "levels": {
          "lin_xiaozhou": 1
        },
        "transforming": true
      },
      "expected_effects": [
        {
          "kind": "condition",
          "who": "lin_xiaozhou",
