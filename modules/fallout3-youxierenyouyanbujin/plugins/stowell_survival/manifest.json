        "action": "hide_move",
        "arguments": {
          "who": "betty",
          "skill": "侦查"
        }
      },
      "state": {
        "escapes": 0,
        "hide_retry": {
          "betty": true
        },
        "night_phase": "until_midnight"
      },
      "context": {},
      "dice": [],
      "checks": [
        false
      ],
      "expected_state": {
        "hide_retry": {}
      },
      "expected_effects": [
        {
          "kind": "note",
          "text": "再次失败，麻烦了。"
        }
      ]
    },
    {
      "name": "非法技能不检定",
      "event": {
        "hook": "action",
