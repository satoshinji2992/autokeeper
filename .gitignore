# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Copyrighted modules stay local. Anything dropped straight into modules/ (PDF, zip, Word,
# Markdown, text, pictures) is ignored, and so are PDFs, Word files and archives anywhere under
# it; module folders such as modules/zhuishuren/ and modules/README.md stay tracked.
# Imports land in modules/local/. Keep these lines in this order: the last match wins.
/modules/*
!/modules/*/
!/modules/README.md
/modules/**/*.pdf
/modules/**/*.doc
/modules/**/*.docx
/modules/**/*.zip
/modules/**/*.rar
/modules/**/*.7z
modules/_import/
modules/local/
skills/module-*
# What the game writes (src/autokeeper/paths.py); saves/ is the folder 0.0.1 used
data/
saves/
dev/output/
.env
bridge/node_modules/

# Personal planning notes (job targets, resume drafts)
PLAN.md

# Tool caches
.pytest_cache/
.ruff_cache/
