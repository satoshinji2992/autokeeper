# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Copyrighted modules stay local. Drop module files into modules/inbox/; anything dropped
# straight into modules/ (PDF, zip, Word, Markdown, text, pictures) is ignored too, and so are
# PDFs, Word files and archives anywhere under it; module folders such as modules/zhuishuren/
# and modules/README.md stay tracked. Imports land in modules/local/<id>/, their originals in
# its source/. Keep these lines in this order: the last match wins.
/modules/*
!/modules/*/
!/modules/README.md
/modules/**/*.pdf
/modules/**/*.doc
/modules/**/*.docx
/modules/**/*.zip
/modules/**/*.rar
/modules/**/*.7z
modules/inbox/
modules/local/
modules/*/source/
skills/module-*
# What the game writes (src/autokeeper/paths.py); saves/ is the folder 0.0.1 used
data/
saves/
dev/output/
.env
bridge/node_modules/

# Personal planning notes (job targets, resume drafts)
PLAN.md

# Tool caches
.pytest_cache/
.ruff_cache/
# The rulebooks the user keeps beside the code (51 MB of PDFs): read from here, not committed
rule/
