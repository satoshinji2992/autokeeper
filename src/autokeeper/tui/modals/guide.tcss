/* 新手指南 (guide.py); the dimmed backdrop comes from ModalScreen in app.tcss */

GuideScreen #guide {
    width: 120;
    max-width: 100%;
    height: 90%;
    max-height: 42;
    padding: 1 2;
    border: heavy $primary;
    background: $surface;
}
GuideScreen #guide-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}
GuideScreen #guide-body {
    height: 1fr;
}
GuideScreen #guide-pages {
    width: 20;
    height: auto;
    max-height: 100%;
    border: round $primary-darken-1;
    background: $surface;
}
GuideScreen #guide-text {
    width: 1fr;
    height: 1fr;
    margin-left: 1;
}
GuideScreen .guide-page {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
GuideScreen .guide-page:focus {
    background: $boost;
}
GuideScreen Markdown {
    padding: 0;
}
GuideScreen MarkdownH2 {
    margin: 1 0 1 0;
}
GuideScreen MarkdownH2:first-child {
    margin: 0 0 1 0;
}
GuideScreen #guide-foot {
    height: auto;
    margin-top: 1;
}
GuideScreen #guide-help {
    width: 1fr;
    color: $text-muted;
}
GuideScreen MarkdownTable {
    width: auto;
}
GuideScreen MarkdownTableContent {
    grid-gutter: 0 2;
    keyline: none;
}
GuideScreen MarkdownFence {
    margin: 0 0 1 0;
}
GuideScreen MarkdownFence > Label {
    padding: 0 2;
}
GuideScreen #guide-tips:focus {
    border: none;
}
/* the key reference keeps its columns: on a narrow terminal it scrolls sideways instead of wrapping */
GuideScreen #guide-keys {
    overflow-x: auto;
    scrollbar-size-horizontal: 1;
}
GuideScreen #guide-keys > Static {
    width: auto;
}
GuideScreen MarkdownH3 {
    margin: 0 0 1 0;
}
