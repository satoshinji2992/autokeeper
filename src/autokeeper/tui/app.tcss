Screen {
    background: $background;
    color: $foreground;
}
/* Ctrl+P still opens the command palette; the footers point to the Esc menu instead */
Footer FooterKey.-command-palette {
    display: none;
}

/* ---------- title ---------- */
#title-screen {
    layers: back front;
}
#title-cover {
    layer: front;
    width: 100%;
    height: 100%;
}
#menu {
    layer: back;  /* under the cover, which paints it see-through; it only takes the keys */
    position: absolute;
    width: 36;
    height: auto;
    max-height: 12;  /* every title option, 开房间 included */
}

/* ---------- setup ---------- */
#setup {
    padding: 1 2;
}
#setup-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}
#setup-body {
    height: 1fr;
}
#choices {
    width: 38;
    border: round $primary-darken-1;
    background: $surface;
}
#choices.saves {
    width: 1fr;
    max-width: 60;
}
#card-left {
    width: 38;
}
#card-left Input {
    border: round $primary-darken-1;
}
#preview {
    width: 1fr;
    padding: 0 2;
    border: round $secondary-darken-2;
    background: $surface;
    overflow-y: auto;
    scrollbar-gutter: stable;
}
#preview-picture {
    text-wrap: nowrap;
    text-overflow: clip;
}
#setup-hint {
    color: $text-muted;
    margin-top: 1;
}
#setup-hint {
    link-color: $text-muted;
    link-style: none;
    link-color-hover: $primary;
    link-background-hover: transparent;
    link-style-hover: bold;
}

/* ---------- the Esc menu and its dialogs (menu.py) ---------- */
#game-menu {
    width: 32;
}
#game-menu OptionList {
    height: auto;
    max-height: 14;
    border: none;
    margin-bottom: 1;
}
#confirm {
    width: 62;
    max-width: 96%;
}
#ask-text {
    width: 64;
    max-width: 96%;
}
#ask-text Input {
    width: 100%;
}

/* ---------- 编辑 a kept card (cardedit.py) ---------- */
#card-edit {
    width: 80;
    max-width: 96%;
}
#card-edit .edit-row {
    height: 1;
    margin-bottom: 1;
}
#card-edit .edit-tall {
    height: 3;
}
#card-edit .edit-label {
    width: 14;
    color: $text-muted;
}
#card-edit Input, #card-edit TextArea {
    width: 1fr;
    background: $panel;
}
#card-edit .edit-note {
    margin-bottom: 1;
}
#card-edit .edit-head {
    color: $primary;
    text-style: bold;
    margin: 1 0;
}

/* ---------- game ---------- */
#topbar {
    height: 1;
    background: $primary-darken-3;
    color: $foreground;
    padding: 0 1;
}
#main {
    height: 1fr;
}
#left {
    width: 1fr;
}
#right {
    width: 40;
    border-left: tall $primary-darken-2;
    background: $surface;
}
#stage {
    height: auto;
    border-bottom: dashed $primary-darken-2;
}
#scene {
    height: auto;
    max-height: 28;
    padding: 0 1;
    color: $primary;
}
#scene.dread {
    color: $error;
}
#story {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
#status {
    height: 1;
    padding: 0 1;
    color: $secondary;
}
#picker {
    display: none;
    height: auto;
    max-height: 10;
    border: round $primary;
    background: $surface;
}
#command {
    border: tall $primary-darken-1;
    background: $surface;
}
#command:focus {
    border: tall $primary;
}

.entry {
    margin: 1 0 0 0;
}
.keeper {
    color: $foreground;
}
.player {
    color: $text-muted;
    text-style: italic;
}
.echo {
    color: $foreground;
    text-style: italic;
}
.npc {
    padding: 0 1;
    border-left: thick $accent;
}
.dice {
    color: $secondary;
}
.clue {
    border: round $success;
    padding: 0 1;
    color: $foreground;
}
.handout {
    color: $warning;
}
.event {
    content-align: center middle;
    text-style: bold;
    color: $warning;
}
.sanity {
    color: $error;
    text-style: bold;
}
.system {
    color: $text-muted;
}
.performance {
    border: double $accent;
    padding: 0 1;
    color: $foreground;
}
.ending {
    border: heavy $primary;
    padding: 1 2;
    text-style: bold;
}

#sheet {
    height: auto;
    max-height: 14;
    overflow-y: auto;
    padding: 0 1;
}
#dice {
    height: 11;
    padding: 0 1;
    border-top: dashed $primary-darken-2;
    content-align: center middle;
}
/* 经过 / 进展 / 背景: one row of tabs, the page under it */
#pages {
    height: 1fr;
    min-height: 4;  /* game.PAGES_MIN */
    border-top: dashed $primary-darken-2;
}
#pages > ContentTabs {
    height: 1;
}
#pages Tab {
    padding: 0 1;
}
#pages Tab.-active {
    color: $background;
    background: $primary;
    text-style: bold;
}
#pages ContentTabs:focus Tab.-active {
    text-style: bold underline;  /* ←/→ turn the page now */
}
#pages > ContentSwitcher, #pages TabPane {
    height: 1fr;
    padding: 0;
}
#history, .page {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
#history HistoryLine:hover {
    background: $panel;
}
#pages-modal {
    width: 110;
    max-width: 96%;
    height: 90%;
}
#pages-head {
    height: 1;
    padding: 0 1;
}
#pages-head:hover {
    background: $panel;
}
#pages-modal #pages {
    border-top: none;
}
#turnline {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}
#turnline.mine {
    background: $accent;
    color: $background;
    text-style: bold;
}
#command.mine {
    border: tall $accent;
}
#clues {
    height: auto;
    max-height: 12;
    padding: 0 1;
    border-top: dashed $primary-darken-2;
    overflow-y: auto;
}

/* ---------- modals ---------- */
ModalScreen {
    align: center middle;
    background: $background 70%;
}
.modal {
    width: auto;
    max-width: 96;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: heavy $primary;
    background: $surface;
}
.modal-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}
.modal-body {
    height: auto;
    max-height: 30;
    overflow-y: auto;
}
#mode {
    width: 100%;
    margin: 1 0 0 0;
}
#sheet-modal {
    max-width: 124;
    height: 90%;
}
#sheet-modal .modal-body {
    height: 1fr;  /* scrolls inside the window, however small the terminal */
    max-height: 100%;
}
/* the map (mapview.py): sizes are set from the screen it is on */
#map-modal {
    max-width: 100%;
    max-height: 100%;
}
#map-body {
    height: auto;
}
#map-view {
    scrollbar-size: 1 1;
}
#map {
    width: auto;
    height: auto;
}
#map-place {
    margin: 0 0 0 2;
}
#map-body.under #map-place {
    margin: 1 0 0 0;
}
#map-legend {
    margin-top: 1;
}
.buttons {
    height: auto;
    margin-top: 1;
    align: center middle;
}
.buttons Button {
    margin: 0 1;
}
#canvas {
    width: 72;
    height: 22;
    border: round $secondary;
}
#ending-art {
    color: $primary;
}
